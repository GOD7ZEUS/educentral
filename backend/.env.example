# Postgres connection string. Locally, point this at your own Postgres (or a
# free cloud instance from Neon/Supabase); in Render this is supplied
# automatically from the educentral-db resource in render.yaml.
DATABASE_URL="postgresql://user:password@localhost:5432/educentral"

# Sign a real random secret for production — never reuse the dev default.
JWT_SECRET="dev-secret-change-in-production"

PORT=4000

# Only read in production (NODE_ENV=production) by prisma/seed.ts, to create
# the very first Master Admin account. Leave unset locally.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=
