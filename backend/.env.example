# MySQL connection string. Locally, point this at your own MySQL (or a free
# cloud instance from Railway/Aiven/Clever Cloud); Render has no managed
# MySQL, so in production this is a manually-set env var, not auto-wired.
DATABASE_URL="mysql://user:password@localhost:3306/educentral"

# Sign a real random secret for production — never reuse the dev default.
JWT_SECRET="dev-secret-change-in-production"

PORT=4000

# Only read in production (NODE_ENV=production) by prisma/seed.ts, to create
# the very first Master Admin account. Leave unset locally.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=
