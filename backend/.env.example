# Local dev only — a plain SQLite file. `prisma migrate`/`db push`/Studio all
# work normally against this. Not used in production.
DATABASE_URL="file:./dev.db"

# Production only. When set, the app connects to Turso via the libSQL driver
# adapter instead of DATABASE_URL (see src/prisma.ts). Leave both unset locally.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Sign a real random secret for production — never reuse the dev default.
JWT_SECRET="dev-secret-change-in-production"

PORT=4000

# Only read in production (NODE_ENV=production) by prisma/seed.ts, to create
# the very first Master Admin account. Leave unset locally.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=
